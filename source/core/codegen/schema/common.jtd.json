{
  "definitions": {
    "arch": { "enum": ["x86_64", "aarch64", "wasm32"] },
    "os": { "enum": ["windows", "linux", "macos", "wasi", "freestanding"] },
    "abi": { "enum": ["gnu", "musl", "msvc", "apple", "none"] },
    "linkage": { "enum": ["shared", "static", "source", "object"] },
    "cc_driver": { "enum": ["gcc", "clang", "msvc", "zig"] },
    "ld_family": { "enum": ["gnu", "lld", "ld64", "msvc"] },
    "index_protocol": { "enum": ["git", "http", "dir"], "metadata": { "include": "index/types.h" } },
    "option_type": { "enum": ["bool", "enum"], "metadata": { "include": "when/types.h" } },
    "pkg_source": { "enum": ["root", "file", "index"], "metadata": { "include": "pkg/types.h" } },
    "pkg_root_kind": { "enum": ["none", "local", "git"], "metadata": { "include": "pkg/types.h" } },

    "triple": {
      "optionalProperties": {
        "arch": { "ref": "arch" },
        "os": { "ref": "os" },
        "abi": { "ref": "abi" }
      }
    },

    "toolchain_target": {
      "optionalProperties": {
        "arch": { "ref": "arch" },
        "os": { "ref": "os" },
        "abi": { "ref": "abi" },
        "sdk": { "type": "string" }
      }
    },

    "artifact": {
      "optionalProperties": {
        "url": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },

    "toolchain_decl": {
      "optionalProperties": {
        "name": { "type": "string" },
        "compiler": { "type": "string" },
        "linker": { "ref": "ld_family" },
        "link_args": { "elements": { "type": "string" } },
        "archiver": { "type": "string" },
        "driver": { "ref": "cc_driver" },
        "cxx": { "type": "string" },
        "host": { "values": { "ref": "artifact" } },
        "mirrors": { "type": "string" },
        "target": { "elements": { "ref": "toolchain_target" } }
      }
    },

    "index": {
      "properties": {
        "name": { "type": "string" }
      },
      "optionalProperties": {
        "url": { "type": "string" },
        "path": { "type": "string" },
        "protocol": { "ref": "index_protocol" },
        "rev": { "type": "string" },
        "publish_url": { "type": "string" }
      }
    }
  }
}
