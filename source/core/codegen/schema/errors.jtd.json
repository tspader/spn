    "resolve_too_complex": { "ref": "too_complex" },
    "option_undeclared": { "ref": "option" },
    "option_bad_value": { "ref": "option" },
    "option_conflict": { "ref": "option" },
    "option_veto": { "ref": "option" },
    "option_no_value": { "ref": "option" },
    "option_late_gate": { "ref": "option" },
    "option_unknown_pkg": { "ref": "option" },
    "configure_source_glob": { "ref": "configure_source" },
    "configure_source_missing": { "ref": "configure_source" },
    "init_exists": { "ref": "fs" },
    "init_name": { "ref": "pkg" },
    "scaffold_template": { "ref": "fs" },
    "test_missing": { "ref": "script" },
    "test_failed": { "properties": {} },
    "version_invalid": { "ref": "version_invalid" },
    "cancelled": { "properties": {} },
    "patch_unused": { "ref": "patch" },
    "patch_not_git": { "ref": "patch" },
    "header_collision": { "ref": "header_collision" },
    "path_component": { "ref": "fs" }
  },
  "definitions": {
    "manifest_parse": {
      "properties": {
        "path": { "type": "string" }
      }
    },
    "manifest": {
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "issues": { "elements": { "ref": "issue" } }
      }
    },
    "issue": {
      "properties": {
        "code": { "metadata": { "extern": "err" } },
        "path": { "type": "string" }
      },
      "optionalProperties": {
        "detail": { "type": "string" }
      }
    },
    "no_manifest": {
      "properties": {
        "path": { "type": "string" }
      }
    },
    "not_git_repo": {
      "properties": {
        "path": { "type": "string" }
      }
    },
    "git": {
      "properties": {
        "command": { "type": "string" }
      }
    },
    "version_exists": {
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "version_invalid": {
      "properties": {
        "requested": { "type": "string" }
      }
    },
    "build_graph": {
      "properties": {
        "file": { "type": "string" }
      }
    },
    "toolchain": {
      "properties": {
        "name": { "type": "string" },
        "target": { "metadata": { "extern": "triple" } },
        "host": { "metadata": { "extern": "triple" } },
        "candidates": { "elements": { "type": "string" } },
        "targets": { "elements": { "type": "string" } }
      }
    },
    "completion": {
      "properties": {
        "target": { "metadata": { "extern": "triple" } },
        "host": { "metadata": { "extern": "triple" } },
        "candidates": { "elements": { "type": "string" } }
      }
    },
    "program": {
      "properties": {
        "name": { "type": "string" },
        "program": { "type": "string" }
      }
    },
    "cc_feature": { "enum": ["compile", "link_exe", "link_shared", "link_reactor", "archive", "frameworks"] },
    "artifact": {
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" }
      }
    },
    "wasm": {
      "properties": {
        "path": { "type": "string" },
        "error": { "type": "string" },
        "rc": { "type": "int32" }
      }
    },
    "profile": {
      "properties": {
        "name": { "type": "string" }
      }
    },
    "sanitizer": {
      "properties": {
        "toolchain": { "type": "string" },
        "target": { "metadata": { "extern": "triple" } },
        "unsupported": { "metadata": { "extern": "sanitizer_set" } },
        "supported": { "metadata": { "extern": "sanitizer_set" } }
      }
    },
    "compiler": {
      "properties": {
        "toolchain": { "type": "string" },
        "target": { "metadata": { "extern": "triple" } },
        "feature": { "ref": "cc_feature" }
      }
    },
    "fs": {
      "properties": {
        "path": { "type": "string" }
      }
    },
    "index": {
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "index_corrupt": {
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "publish": {
      "properties": {
        "url": { "type": "string" },
        "rev": { "type": "string" },
        "path": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "pkg": {
      "properties": {
        "name": { "type": "string" },
        "requested": { "type": "string" }
      }
    },
    "unknown": {
      "properties": {
        "qualified": { "type": "string" }
      },
      "optionalProperties": {
        "range": { "type": "string" }
      }
    },
    "unsatisfiable": {
      "properties": {
        "qualified": { "type": "string" }
      },
      "optionalProperties": {
        "range": { "type": "string" },
        "requester": { "type": "string" },
        "requester_version": { "metadata": { "extern": "semver" } },
        "selected": { "metadata": { "extern": "semver" } }
      }
    },
    "mismatch": {
      "properties": {
        "path": { "type": "string" },
        "declared": { "type": "string" },
        "requested": { "type": "string" }
      }
    },
    "dag": {
      "properties": {
        "path": { "type": "string" }
      }
    },
    "pkg_name": {
      "properties": {
        "name": { "type": "string" }
      },
      "optionalProperties": {
        "namespace": { "type": "string" }
      }
    },
    "circular": {
      "properties": {
        "id": { "ref": "pkg_name" }
      }
    },
    "unit_cycle": {
      "properties": {
        "id": { "ref": "pkg_name" },
        "version": { "metadata": { "extern": "semver" } }
      }
    },
    "dynamic_dup": {
      "properties": {
        "id": { "ref": "pkg_name" },
        "low": { "metadata": { "extern": "semver" } },
        "high": { "metadata": { "extern": "semver" } }
      }
    },
    "too_complex": {
      "properties": {
        "id": { "ref": "pkg_name" }
      }
    },
    "target": {
      "properties": {
        "pkg": { "type": "string" },
        "name": { "type": "string" },
        "requested": { "type": "string" },
        "requester": { "type": "string" }
      }
    },
    "script": {
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "code": { "type": "int32" }
      }
    },
    "option_setter_kind": { "enum": ["none", "default", "profile", "root_manifest", "union", "consumer"] },
    "setter": {
      "properties": {
        "kind": { "ref": "option_setter_kind" }
      },
      "optionalProperties": {
        "name": { "type": "string" }
      }
    },
    "option": {
      "properties": {
        "pkg": { "type": "string" },
        "a": { "ref": "setter" },
        "b": { "ref": "setter" }
      },
      "optionalProperties": {
        "option": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "configure_source": {
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "patch": {
      "properties": {
        "name": { "type": "string" }
      }
    },
    "header_collision": {
      "properties": {
        "path": { "type": "string" },
        "first": { "type": "string" },
        "second": { "type": "string" }
      }
    }
  }
}
