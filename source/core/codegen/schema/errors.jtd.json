    "index_pinned": { "ref": "index" },
    "index_corrupt": { "ref": "index_corrupt" },
    "index_publish_protocol": { "ref": "index" },
    "publish_push": { "ref": "publish" },
    "publish_dirty": { "ref": "publish" },
    "publish_unpushed": { "ref": "publish" },
    "index_path_dep": { "ref": "pkg" },
    "pkg_unknown": { "ref": "unknown" },
    "pkg_no_match": { "ref": "unsatisfiable" },
    "pkg_conflict": { "ref": "unsatisfiable" },
    "pkg_conflict_exact": { "ref": "unsatisfiable" },
    "pkg_mismatch": { "ref": "mismatch" },
    "manifest_edit": { "ref": "manifest_parse" },
    "dag_glob": { "properties": {} },
    "dag_output_name": { "properties": {} },
    "dag_duplicate_output": { "properties": {} },
    "dag_stat": { "properties": {} },
    "dag_missing_input": { "ref": "dag" },
    "dag_missing_output": { "ref": "dag" },
    "dag_scratch": { "properties": {} },
    "dag_action": { "properties": {} },
    "dag_store_read": { "ref": "dag" },
    "dag_store_write": { "ref": "dag" },
