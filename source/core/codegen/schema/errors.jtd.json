    "wasm_read_failed": { "ref": "wasm" },
    "wasm_thread_env_failed": { "ref": "wasm" },
    "wasm_script_error": { "ref": "wasm" },
    "wasm_no_script": { "ref": "wasm" },
    "wasm_export_not_found": { "ref": "wasm" },
    "profile_invalid": { "ref": "profile" },
    "profile_undefined": { "ref": "profile" },
    "sanitizer_unsupported": { "ref": "sanitizer" },
    "sanitizer_static": { "ref": "sanitizer" },
    "compiler_feature_unsupported": { "ref": "compiler" },
    "toc_magic": { "ref": "fs" },
    "toc_truncated": { "ref": "fs" },
