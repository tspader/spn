diff --git a/core/shared/platform/common/posix/posix_thread.c b/core/shared/platform/common/posix/posix_thread.c
index 80b7d65..d1566cc 100644
--- a/core/shared/platform/common/posix/posix_thread.c
+++ b/core/shared/platform/common/posix/posix_thread.c
@@ -11,6 +11,10 @@
 #include "platform_api_vmcore.h"
 #include "platform_api_extension.h"
 
+#ifdef __linux__
+#include <sys/syscall.h>
+#endif
+
 #if defined(__APPLE__) || defined(__MACH__)
 #include <TargetConditionals.h>
 #endif
@@ -452,6 +456,19 @@ os_thread_get_stack_boundary()
         pthread_attr_getstack(&attr, (void **)&addr, &stack_size);
         pthread_attr_getguardsize(&attr, &guard_size);
         pthread_attr_destroy(&attr);
+#if !defined(__GLIBC__)
+        /* musl reports only the currently mapped extent of the main
+           thread's stack; size it from the rlimit like glibc does */
+        if (getpid() == (pid_t)syscall(SYS_gettid)) {
+            struct rlimit rl;
+            if (getrlimit(RLIMIT_STACK, &rl) == 0
+                && rl.rlim_cur != RLIM_INFINITY
+                && (size_t)rl.rlim_cur > stack_size) {
+                addr = addr + stack_size - (size_t)rl.rlim_cur;
+                stack_size = (size_t)rl.rlim_cur;
+            }
+        }
+#endif
         if (stack_size > max_stack_size)
             addr = addr + stack_size - max_stack_size;
         addr += guard_size;
