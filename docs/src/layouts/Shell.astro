---
import '@spn/docs/styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLElement>('.code-copy')
        if (!button) return
        const pre = button.parentElement!.querySelector<HTMLElement>(':scope > pre:not([hidden])')!
        await navigator.clipboard.writeText(pre.textContent!)
        button.classList.add('copied')
        setTimeout(() => button.classList.remove('copied'), 1500)
      })
    </script>
  </body>
</html>
