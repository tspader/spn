{
  "package": {
    "name": "tclinkers",
    "version": "1.0.0"
  },
  "toolchain": [
    {
      "name": "llvm",
      "compiler": "clang",
      "linker": {
        "elf": "lld",
        "mingw": "gnu",
        "msvc": "msvc",
        "macho": "ld64",
        "wasm": "lld"
      },
      "link_args": [
        "-fuse-ld=lld"
      ],
      "archiver": "llvm-ar",
      "driver": "clang"
    }
  ]
}